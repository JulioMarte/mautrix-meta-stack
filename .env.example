# In Coolify, define these as runtime/build environment variables.
MATRIX_SERVER_NAME=matrix.example.com
MATRIX_ADMIN_MXID=@admin:matrix.example.com
# Set this as a secret in Coolify. It is used only by the one-shot admin provisioner.
MATRIX_ADMIN_PASSWORD=replace-with-a-strong-password

# Meta Control Plane secrets. Never commit real values.
CONTROL_PLANE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
CONTROL_PLANE_INTERNAL_TOKEN=replace-with-a-distinct-long-random-internal-token
# Proxy credentials are referenced as env:VARIABLE from egress profiles. Example only:
# EGRESS_PROXY_TENANT_A_PASSWORD=replace-in-coolify
# Chatwoot API credentials are referenced as env:CHATWOOT_* from Chatwoot bindings. Example only:
# CHATWOOT_TENANT_A_TOKEN=replace-in-coolify
# Chatwoot webhook HMAC secrets use a distinct namespace and MUST NOT reuse API tokens.
# CHATWOOT_WEBHOOK_TENANT_A_SECRET=replace-with-a-distinct-webhook-signing-secret

# Matrix media retrieval for Matrix -> Chatwoot attachments.
# Use a dedicated Matrix access token with the minimum permissions needed to download
# media visible to the bridge/control-plane integration. Never put this token in URLs.
MATRIX_MEDIA_BASE_URL=http://synapse:8008
MATRIX_MEDIA_ACCESS_TOKEN=replace-with-a-dedicated-matrix-access-token
MATRIX_MEDIA_TIMEOUT_MS=15000
# Application-side safety cap in bytes; this is not a claimed Chatwoot provider limit.
MATRIX_MEDIA_MAX_BYTES=104857600

# Matrix Client API sender for Chatwoot -> Matrix replies. This token may be the same
# service account as MATRIX_MEDIA_ACCESS_TOKEN only when that account intentionally has
# both download/upload and room-send permissions; keep the variables explicit either way.
MATRIX_CLIENT_BASE_URL=http://synapse:8008
MATRIX_CLIENT_ACCESS_TOKEN=replace-with-a-dedicated-matrix-sender-access-token
MATRIX_CLIENT_TIMEOUT_MS=15000
MATRIX_CLIENT_MAX_BYTES=104857600

TZ=America/Santo_Domingo

# Persistent data is stored in Docker named volumes managed by Compose/Coolify.

# Pin releases. Do not use latest in production.
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.160.0
MAUTRIX_META_IMAGE=dock.mau.dev/mautrix/meta:v26.07
YQ_IMAGE=mikefarah/yq:4.47.2
