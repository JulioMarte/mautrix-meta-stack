# In Coolify, define these as runtime/build environment variables.
MATRIX_SERVER_NAME=matrix.example.com
MATRIX_ADMIN_MXID=@admin:matrix.example.com
# Secret: used by the one-shot Matrix admin provisioner and integration sidecar.
MATRIX_ADMIN_PASSWORD=replace-with-a-strong-password
TZ=America/Santo_Domingo

# NiceGUI integration admin. Keep all of these secret.
INTEGRATION_ADMIN_PASSWORD=replace-with-a-strong-admin-password
INTEGRATION_SESSION_SECRET=replace-with-at-least-32-random-characters
CHATWOOT_WEBHOOK_SECRET=replace-with-a-random-webhook-path-secret
# Must be URL-safe because mautrix-meta carries it as internal HTTP Basic credentials.
# Recommended: openssl rand -hex 32
META_PROXY_RESOLVER_SECRET=replace-with-a-long-url-safe-random-token

# Production admin must be routed through HTTPS by Coolify/Traefik.
INTEGRATION_COOKIE_SECURE=true
ALLOW_INSECURE_CHATWOOT=false

# Optional Meta-only proxy. Do NOT use HTTP_PROXY/HTTPS_PROXY for this stack.
# Store META_PROXY_URL as a Coolify secret. Example only; never commit real credentials.
META_PROXY_ENABLED=false
META_PROXY_URL=
# Example shape when enabled:
# META_PROXY_URL=http://proxy-user:proxy-password@proxy.example.net:8888

# NiceGUI server-side user/session storage is persisted in integration-data-v1.
NICEGUI_STORAGE_PATH=/data/nicegui

# Chatwoot URL/account/inbox/API token are configured after startup from /admin.
# If META_PROXY_URL is set, the proxy is managed by Coolify and shown redacted/read-only in /admin.

# Persistent data is stored in Docker named volumes managed by Compose/Coolify.

# Pin releases. Do not use latest in production.
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.160.0
MAUTRIX_META_IMAGE=dock.mau.dev/mautrix/meta:v26.07
YQ_IMAGE=mikefarah/yq:4.47.2
